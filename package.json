{
	"name": "clinical-faker",
	"version": "0.1.0",
	"description": "Zero-dependency, TypeScript-first synthetic clinical data generator for HL7 v2 and FHIR R4 integration testing.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18",
		"bun": ">=1.1.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build:js": "bun build ./src/index.ts --outdir dist --target node --format esm",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
		"build": "bun run build:js && bun run build:types",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"ci:lint": "biome ci ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"typescript": "6.0.3"
	}
}
