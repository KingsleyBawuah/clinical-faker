{
	"name": "clinical-faker",
	"version": "0.1.0",
	"description": "Zero-dependency, TypeScript-first synthetic clinical data generator for HL7 v2 and FHIR R4 integration testing.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"./src/index.ts"
	],
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18",
		"bun": ">=1.1.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build:js": "bun build ./src/index.ts --outdir dist --target node --format esm",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
		"build": "bun run build:js && bun run build:types",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"ci:lint": "biome ci .",
		"type-coverage": "type-coverage --at-least 100 --strict",
		"license-check": "license-checker --failOn 'GPL-1.0;GPL-2.0;GPL-3.0;AGPL-1.0;AGPL-3.0;LGPL-2.0;LGPL-2.1;LGPL-3.0;SSPL-1.0;CPAL-1.0' --summary"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@types/bun": "1.4.0",
		"license-checker": "25.0.1",
		"type-coverage": "2.30.1",
		"typescript": "6.0.3"
	}
}
